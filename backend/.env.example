MONGO_URI=mongodb://127.0.0.1:27017/newshub
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=replace-with-your-razorpay-test-secret
SUBSCRIPTION_PRICE=99
ADMIN_SETUP_KEY=replace-with-a-long-one-time-setup-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-provider-app-password
MAIL_FROM=NewsHub <your-email@example.com>

# Used only by: npm run seed:admin
ADMIN_NAME=NewsHub Admin
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional public payment details for the admin profile
ADMIN_PAYMENT_ACCOUNT_NAME=
ADMIN_UPI_ID=
ADMIN_PAYMENT_LINK=
